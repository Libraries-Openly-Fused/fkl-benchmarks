diff --git a/include/fused_kernel/core/execution_model/operation_model/chain_check.h b/include/fused_kernel/core/execution_model/operation_model/chain_check.h
new file mode 100644
index 0000000..7e63b5d
--- /dev/null
+++ b/include/fused_kernel/core/execution_model/operation_model/chain_check.h
@@ -0,0 +1,132 @@
