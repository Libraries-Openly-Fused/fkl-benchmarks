+// NaN REVIEW (a local copy for the NaN count, not committed): counts the NaN, Inf and zero values of a bf16 array
+__global__ void countNonFiniteBf16(const bf16* x, const size_t n, unsigned long long* counts) {
+    const size_t i = blockIdx.x * static_cast<size_t>(blockDim.x) + threadIdx.x;
+    if (i >= n) { return; }
+    const unsigned short u = __bfloat16_as_ushort(x[i]);
+    if (((u >> 7) & 0xFF) == 0xFF) { atomicAdd(&counts[(u & 0x7F) != 0 ? 0 : 1], 1ULL); }
+    else if ((u & 0x7FFF) == 0) { atomicAdd(&counts[2], 1ULL); }
+}
